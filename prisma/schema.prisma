// Prisma Schema for Enterprise CRM
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_AGENT
  CHARGING_MANAGER
  CHARGING_OPERATOR
  CS_MANAGER
  CS_AGENT
}

enum DepartmentType {
  ADMIN
  SALES
  CHARGING
  CUSTOMER_SERVICE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  FINAL
  CHARGING
  SUCCESS
  FAILED
  ARCHIVED
}

enum VerificationStatus {
  PASS
  FAIL
  NEUTRAL
  NONE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketType {
  ONBOARDING
  BILLING
  TECHNICAL
  GENERAL
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  plan        String   @default("ENTERPRISE")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  departments Department[]
  leads       Lead[]
  customers   Customer[]
  tickets     Ticket[]
  transactions Transaction[]
  activityLogs ActivityLog[]
  auditLogs   AuditLog[]
  distributionPolicies DistributionPolicy[]
}

model Department {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        DepartmentType
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users       User[]
  policies    DistributionPolicy[]

  @@unique([tenantId, type])
}

model User {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  email        String      @unique
  name         String
  role         Role
  avatarUrl    String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedLeads     Lead[]           @relation("AssignedLeads")
  assignedTickets   Ticket[]         @relation("AssignedTickets")
  processedPayments Transaction[]    @relation("ProcessedTransactions")
  activityLogs      ActivityLog[]    @relation("ActorActivity")
  auditLogs         AuditLog[]       @relation("ActorAudit")
}

model Lead {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?       @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String?
  company      String?
  status       LeadStatus  @default(NEW)
  dealValue    Float       @default(0.0)
  currency     String      @default("USD")
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  footprint         LeadFootprint?
  emailVerification EmailVerification?
  transactions      Transaction[]
  customer          Customer?
  tickets           Ticket[]
  activityLogs      ActivityLog[]

  @@index([tenantId, status])
  @@index([assignedToId])
}

model LeadFootprint {
  id           String   @id @default(uuid())
  leadId       String   @unique
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ipAddress    String
  userAgent    String
  referrer     String?
  country      String?
  city         String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  clickstream  Json     // Clickstream events array stored in JSONB
  rawHeaders   Json?    // Raw HTTP request headers in JSONB
  createdAt    DateTime @default(now())
}

model EmailVerification {
  id              String             @id @default(uuid())
  leadId          String             @unique
  lead            Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  email           String
  spfResult       VerificationStatus @default(NONE)
  dkimResult      VerificationStatus @default(NONE)
  dmarcResult     VerificationStatus @default(NONE)
  mxRecordExists  Boolean            @default(false)
  smtpCheckValid  Boolean            @default(false)
  score           Float              @default(0.0) // Authenticity score (0.0 to 100.0)
  rawDetails      Json?              // Raw DNS & verification check payload in JSONB
  verifiedAt      DateTime           @default(now())
}

model Transaction {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId                String
  lead                  Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId            String?
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  processedById         String?
  processedBy           User?             @relation("ProcessedTransactions", fields: [processedById], references: [id], onDelete: SetNull)
  amount                Float
  currency              String            @default("USD")
  status                TransactionStatus @default(PENDING)
  paymentMethod         String            @default("CREDIT_CARD")
  gatewayTxnId          String?
  verificationChecklist Json?             // Financial verification steps checklist in JSONB
  failureReason         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([leadId])
}

model Customer {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId           String?       @unique
  lead             Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name             String
  email            String
  phone            String?
  company          String?
  tier             String        @default("ENTERPRISE")
  healthScore      Int           @default(100) // 0-100 score
  onboardingStatus String        @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  transactions     Transaction[]
  tickets          Ticket[]

  @@index([tenantId, email])
}

model Ticket {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedToId  String?
  assignedTo    User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  title         String
  description   String
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  type          TicketType     @default(ONBOARDING)
  slaDeadline   DateTime
  isSlaBreached Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([assignedToId])
  @@index([slaDeadline])
}

model ActivityLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String   // LEAD, TRANSACTION, TICKET, CUSTOMER
  entityId   String
  actorId    String?
  actor      User?    @relation("ActorActivity", fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  actorRole  String
  action     String   // CREATED, QUALIFIED, TRANSITION_FINAL, CHARGING_INITIATED, PAYMENT_SUCCESS, TICKET_CREATED, etc.
  fromState  String?
  toState    String?
  metadata   Json?    // Context payload in JSONB
  createdAt  DateTime @default(now())

  lead       Lead?    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ActorAudit", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action    String
  resource  String
  ipAddress String
  status    String   // SUCCESS, DENIED, ERROR
  payload   Json?
  timestamp DateTime @default(now())

  @@index([tenantId, timestamp])
}

model DistributionPolicy {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  type         String         // ROUND_ROBIN, WEIGHTED, SKILL_BASED
  isActive     Boolean        @default(true)
  config       Json           // Rule configurations in JSONB
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}
