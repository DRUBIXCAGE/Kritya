# ================================================================
# KRITYA ENTERPRISE CRM - ENVIRONMENT CONFIGURATION
# ================================================================

# ----------------------------------------------------------------
# 1. TRAVELOCASE.COM WEBHOOK CONFIGURATION
# ----------------------------------------------------------------
# Webhook Endpoint: POST /api/webhooks/travelocase  (or POST /api/leads)
# Optional shared secret header verification (x-webhook-secret: YOUR_SECRET)
TRAVELOCASE_WEBHOOK_SECRET=travelocase_live_secret_key_839201
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------
# 2. SMTP EMAIL DISPATCH CONFIGURATION (Nodemailer Transport)
# ----------------------------------------------------------------
# Configure standard SMTP server for sending flight authorization,
# confirmations, itineraries, and cancellation emails.
# Supports Gmail, SendGrid, Amazon SES, Mailgun, Office 365, or cPanel SMTP.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ticketing@travelocase.com
SMTP_PASS=your-app-password-here
SMTP_FROM="Travelocase Reservations & Ticketing Desk" <ticketing@travelocase.com>

# ----------------------------------------------------------------
# 3. DATABASE & SESSION SECURITY
# ----------------------------------------------------------------
DATABASE_URL="file:./kritya_crm_db.json"
NODE_ENV=development
